---
// Five-step process timeline. Each step restates something the site already
// commits to (same-day callback, photo or on-site assessment, one written
// price, Adam pulls permits and handles inspections, labeled work).
const steps = [
  {
    name: 'Call or text',
    text: 'Adam reads every request and calls back the same business day.',
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/>',
  },
  {
    name: 'Assessment',
    text: 'Send a photo of the problem or book an on-site look.',
    icon: '<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/>',
  },
  {
    name: 'Written quote',
    text: 'One written price before any work starts.',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/>',
  },
  {
    name: 'Permits and scheduling',
    text: 'Adam pulls the permits and schedules the inspection.',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>',
  },
  {
    name: 'Clean install',
    text: 'Neat work, every circuit labeled, signed off to code.',
    icon: '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/>',
  },
];
---

<section class="process" aria-labelledby="process-title">
  <div class="container">
    <h2 id="process-title" class="process__title">How working with Keif Electric works</h2>
    <p class="process__sub">One electrician from the first call to the final inspection.</p>
    <ol class="process__steps">
      {steps.map((step, i) => (
        <li class:list={['process__step', { 'process__step--first': i === 0 }]}>
          <span class="process__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={step.icon} />
            <span class="process__num">{i + 1}</span>
          </span>
          <h3 class="process__name">{step.name}</h3>
          <p class="process__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .container { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }

  .process { background: var(--ke-sand); padding: 104px 0; text-align: center; }
  .process__title { font-family: var(--font-sans); font-weight: 900; font-size: clamp(34px, 4vw, 54px); letter-spacing: -0.02em; line-height: 1.04; color: var(--ke-ink); margin: 0 0 12px; padding-top: 22px; position: relative; }
  .process__title::before { content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 56px; height: 3px; border-radius: 2px; background: var(--ke-orange); }
  .process__sub { font-size: 16px; color: var(--fg-2); margin: 0 0 48px; }
  .process__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24px; position: relative; }
  .process__steps::before { content: ''; position: absolute; top: 30px; left: 10%; right: 10%; height: 2px; background: var(--border-1); }
  .process__step { position: relative; display: flex; flex-direction: column; align-items: center; }
  .process__icon { position: relative; width: 60px; height: 60px; border-radius: 50%; background: #fff; border: 1px solid var(--border-1); color: var(--ke-orange-text); display: grid; place-items: center; margin-bottom: 18px; }
  .process__icon svg { width: 22px; height: 22px; }
  .process__step--first .process__icon { background: var(--ke-orange); border-color: var(--ke-orange); color: #fff; box-shadow: 0 8px 20px rgba(243, 152, 31, 0.35); }
  .process__num { position: absolute; top: -6px; right: -8px; min-width: 24px; height: 24px; padding: 0 6px; border-radius: 12px; background: var(--ke-ink); color: var(--ke-bone); font-size: 12px; font-weight: 700; line-height: 24px; }
  .process__name { font-family: var(--font-sans); font-size: 16px; font-weight: 700; color: var(--ke-ink); margin: 0 0 6px; }
  .process__text { font-size: 14px; line-height: 1.5; color: var(--fg-2); margin: 0; max-width: 22ch; }

  @media (max-width: 860px) {
    .process { padding: 64px 0; text-align: left; }
    .process__title::before { left: 0; transform: none; }
    .process__sub { margin-bottom: 32px; }
    .process__steps { grid-template-columns: 1fr; gap: 28px; }
    .process__steps::before { top: 30px; bottom: 30px; left: 29px; right: auto; width: 2px; height: auto; }
    .process__step { display: grid; grid-template-columns: 60px 1fr; column-gap: 18px; align-items: center; }
    .process__icon { grid-row: span 2; margin: 0; }
    .process__name { margin: 0; align-self: end; }
    .process__text { max-width: none; align-self: start; }
  }
</style>
