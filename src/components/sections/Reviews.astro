---
import { siteContent } from '../../content/site';

const totalReviewCount =
  siteContent.reviewBadges.google.count + siteContent.reviewBadges.yelp.count;

// The marquee renders the review list twice and slides the track exactly
// one list-width, so the loop is seamless. Duration scales with the review
// count to keep the drift speed constant as Adam collects more reviews.
const SECONDS_PER_CARD = 9;
const marqueeDuration = `${siteContent.reviews.length * SECONDS_PER_CARD}s`;
const marqueePasses = [
  { clone: false },
  { clone: true },
];
---

<section class="section section--paper" id="reviews" aria-labelledby="reviews-title">
  <div class="section__head">
    <div>
      <h2 id="reviews-title" class="section__title">Trusted by neighbors across the Central Coast.</h2>
    </div>
    <p class="section__lead">
      Real reviews from real homeowners on Google and Yelp. We treat every job like we'd want our own house treated.
    </p>
  </div>

  {siteContent.reviews.length > 0 && (
    <div class="reviews__marquee">
      <div class="reviews__track" style={`--marquee-duration: ${marqueeDuration}`}>
        {marqueePasses.map((pass) => siteContent.reviews.map((review) => (
          <article
            class={`review-card${pass.clone ? ' review-card--clone' : ''}`}
            aria-hidden={pass.clone ? 'true' : undefined}
          >
            <div class="review-card__stars" role="img" aria-label={`${review.rating} out of 5 stars`}>
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
              ))}
            </div>
            <p class="review-card__body">{review.text}</p>
            <div class="review-card__foot">
              <div class={`review-card__avatar${review.avatarBg ? ' ' + review.avatarBg : ''}`}>{review.avatar}</div>
              <div>
                <p class="review-card__name">{review.name}</p>
                <p class="review-card__meta">{review.location ? `${review.location} · ${review.service}` : review.service}</p>
              </div>
              <span class="review-card__source">{review.source}</span>
            </div>
          </article>
        )))}
      </div>
    </div>
  )}

  <div class="container">
    <div class="reviews__summary" role="note">
      <div class="reviews__summary-stars" aria-hidden="true">
        {[...Array(5)].map(() => (
          <svg viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
        ))}
      </div>
      <strong>{siteContent.reviewBadges.google.rating} from {totalReviewCount} reviews on Google &amp; Yelp</strong>
      <span>Verified 5-star reviews from Central Coast homeowners</span>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 120px 0;
    background: var(--ke-paper);
    border-top: 1px solid var(--border-1);
    border-bottom: 1px solid var(--border-1);
  }

  .section--paper {
    background: var(--ke-paper);
  }

  .container {
    max-width: var(--max);
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  .section__head {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 56px;
    max-width: var(--max);
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  .section__title {
    font-weight: 900;
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 14px 0 0;
    color: var(--ke-ink);
    max-width: 18ch;
  }

  .section__lead {
    font-size: 17px;
    line-height: 1.55;
    color: var(--fg-2);
    max-width: 48ch;
    margin: 0;
    font-weight: 500;
    align-self: end;
  }

  /* Auto-scrolling marquee. The card list is rendered twice and the track
     slides exactly one list-width, so the loop has no visible seam. The
     inter-card gap is a margin on the card rather than `gap` on the track:
     with `gap`, translateX(-50%) lands half a gap short and the seam jumps. */
  .reviews__marquee {
    --review-gap: 20px;
    position: relative;
    overflow: hidden;
    margin-bottom: 36px;
    /* Soften both edges so cards drift in and out instead of being cut off
       against a hard border. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 90px,
      #000 calc(100% - 90px),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 90px,
      #000 calc(100% - 90px),
      transparent
    );
  }

  .reviews__track {
    display: flex;
    width: max-content;
    animation: reviews-scroll var(--marquee-duration, 36s) linear infinite;
  }

  @keyframes reviews-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* Let people stop the motion to actually read a review. focus-within
     covers keyboard users, who cannot hover. */
  .reviews__marquee:hover .reviews__track,
  .reviews__marquee:focus-within .reviews__track {
    animation-play-state: paused;
  }

  .review-card {
    width: min(360px, 78vw);
    flex: none;
    margin-right: var(--review-gap);
    background: var(--ke-paper);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-3);
    padding: 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: box-shadow var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }

  .review-card:hover {
    box-shadow: var(--shadow-2);
  }

  .review-card__stars {
    display: flex;
    gap: 2px;
    color: var(--ke-orange);
  }

  .review-card__stars svg {
    width: 18px;
    height: 18px;
  }

  .review-card__body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ke-ink);
    margin: 0;
    flex: 1;
  }

  .review-card__foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border-1);
  }

  .review-card__avatar {
    width: 42px;
    height: 42px;
    flex: none;
    background: var(--ke-clay);
    color: var(--ke-bone);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.02em;
  }

  .review-card__avatar.bg-amber {
    background: var(--ke-amber);
    color: var(--ke-ink);
  }

  .review-card__avatar.bg-orange {
    background: var(--ke-orange);
    color: #fff;
  }

  .review-card__name {
    font-size: 14px;
    font-weight: 700;
    margin: 0;
    line-height: 1.2;
  }

  .review-card__meta {
    font-size: 12.5px;
    color: var(--fg-2);
    margin-top: 2px;
  }

  .review-card__source {
    margin-left: auto;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-2);
    background: var(--ke-bone);
    padding: 4px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-1);
  }

  .reviews__summary {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: 36px;
    padding: 18px 22px;
    background: var(--ke-paper);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-3);
  }

  .reviews__summary-stars {
    display: flex;
    gap: 2px;
    color: var(--ke-orange);
  }

  .reviews__summary-stars svg {
    width: 18px;
    height: 18px;
  }

  .reviews__summary strong {
    font-size: 16px;
    color: var(--ke-ink);
    margin-right: 4px;
  }

  .reviews__summary span {
    font-size: 14px;
    color: var(--fg-2);
  }

  .reviews__summary-links {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    color: var(--fg-1);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    border: 1px solid var(--border-1);
    border-radius: var(--radius-2);
    transition: background var(--dur-1) var(--ease-out);
    background: transparent;
  }

  .btn:hover {
    background: rgba(36, 32, 33, 0.06);
  }

  .btn svg {
    width: 15px;
    height: 15px;
  }

  /* No animation: fall back to a plain horizontal scroll row, drop the
     duplicate cards so screen readers and scrolling see each review once,
     and remove the edge fade that would otherwise hide the first card. */
  @media (prefers-reduced-motion: reduce) {
    .reviews__marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      scroll-snap-type: x mandatory;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }

    .reviews__track {
      animation: none;
    }

    .review-card {
      scroll-snap-align: start;
    }

    .review-card--clone {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .section__head {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .section {
      padding: 72px 0;
    }

    .reviews__summary {
      flex-wrap: wrap;
    }

    .reviews__summary-links {
      margin-left: 0;
      margin-top: 12px;
      width: 100%;
    }

    .reviews__summary-links .btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
