---
import { siteContent } from '../../content/site';
import ReviewBadges from '../ui/ReviewBadges.astro';
---

<section class="hero" aria-label="Licensed Electrician in San Luis Obispo, CA">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 class="eyebrow">Licensed Electrician in San Luis Obispo, CA</h1>
      <p id="hero-title" class="hero__title">
        <span class="hero__title-line">Wired <span class="hero__title-word">right<span class="hero__title-period">.</span></span></span>
        <span class="hero__title-line hero__title-line--accent">the first <span class="hero__title-word">time<span class="hero__title-period">.</span></span></span>
      </p>
      <p class="hero__offer">Licensed residential electrician in San Luis Obispo, serving Atascadero, Paso Robles, and SLO County.</p>
      <p class="hero__lead">
        Panel upgrades, EV chargers, lighting, troubleshooting, new builds. Permitted, inspected, and completed without surprises.
        Owner-operated by Adam Keif.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href="tel:+18052860477">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
          Call (805) 286-0477
        </a>
        <a class="btn btn--outline btn--lg" href="#contact">
          Get a free quote
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="hero__trust">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg> C-10 licensed, CA #1152084</span>
        <span class="dot" aria-hidden="true"></span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 18h20M5 18v-6a7 7 0 0 1 14 0v6M9 8V5a3 3 0 0 1 6 0v3"/></svg> Liability insured</span>
        <span class="dot" aria-hidden="true"></span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg> Free estimates</span>
      </div>
      <ReviewBadges />
    </div>

    <figure class="hero__media">
      <picture class="hero__picture">
        <source srcset="/assets/adam-keif-labeling-panel-san-luis-obispo.avif" type="image/avif" />
        <img
          class="hero__img"
          src="/assets/adam-keif-labeling-panel-san-luis-obispo.jpg"
          alt="Adam Keif labeling a breaker in an electrical panel on a San Luis Obispo job"
          width="952"
          height="954"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption class="hero__caption"><span class="hero__caption-name">Adam Keif</span> Owner-operator, on a San Luis Obispo panel job</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--ke-bone);
    overflow: hidden;
    min-height: calc(100vh - var(--header-h));
    display: flex;
    flex-direction: column;
  }

  .hero__inner {
    flex: 1;
    display: grid;
    /* minmax(0, ...) so a long title line can never starve the image column */
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 56px;
    align-items: stretch;
    max-width: var(--max);
    width: 100%;
    margin: 0 auto;
    padding: 40px var(--gutter) 40px;
  }

  /* The photo runs to the right edge of the viewport so it reads as a
     photograph, not a card. --bleed is the distance from the column's right
     edge to the viewport edge: the gutter, plus half of whatever is left over
     once the container hits --max. */
  .hero__media {
    --bleed: calc(var(--gutter) + max(0px, (100vw - var(--max)) / 2));
    position: relative;
    margin: 0 calc(-1 * var(--bleed)) 0 0;
    width: calc(100% + var(--bleed));
    min-height: 560px;
    align-self: stretch;
  }
  .hero__picture {
    display: block;
    position: absolute;
    inset: 0;
  }

  /* The face is turned away, so the caption is what makes this a specific
     person rather than a stock-looking trade photo. */
  .hero__caption {
    position: absolute;
    left: 24px;
    bottom: 24px;
    max-width: 320px;
    padding: 12px 16px;
    background: rgba(36, 32, 33, 0.82);
    color: var(--ke-bone);
    font-size: 13px;
    line-height: 1.4;
    border-radius: var(--radius-2);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .hero__caption-name {
    display: block;
    font-weight: 700;
    font-size: 14px;
    color: var(--ke-amber);
    margin-bottom: 2px;
  }

  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 50%;
    border-radius: var(--radius-4) 0 0 var(--radius-4);
  }

  /* Below the split breakpoint the image lands under the CTAs and badges,
     which is well past where it does any work. The mobile hero is the type
     and the call button. */
  @media (max-width: 980px) {
    .hero__inner { grid-template-columns: 1fr; gap: 0; }
    .hero__media { display: none; }
  }

  .container {
    max-width: var(--max);
    margin: 0 auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter);
  }

  .hero__copy {
    max-width: 820px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ke-clay);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .eyebrow::before {
    content: none;
  }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(48px, 4.9vw, 74px);
    line-height: 0.92;
    letter-spacing: -0.005em;
    color: var(--ke-ink);
    margin: 14px 0 0;
    font-variation-settings: "YEAR" 2050;
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-line--accent {
    color: var(--ke-orange);
    position: relative;
  }

  /* The period is the font's own glyph, colored, and glued to its word so it
     can never wrap onto a line by itself. */
  .hero__title-word { white-space: nowrap; }
  .hero__title-period { color: var(--ke-orange); }

  .hero__offer {
    font-size: 20px;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ke-ink);
    max-width: 30ch;
    margin: 28px 0 0;
  }
  .hero__lead {
    font-size: 17px;
    line-height: 1.55;
    max-width: 54ch;
    color: var(--fg-2);
    margin: 12px 0 26px;
    font-weight: 500;
  }

  .hero__lead strong {
    font-weight: 700;
  }

  .hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .btn {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    padding: 13px 18px;
    border-radius: var(--radius-2);
    border: 1px solid transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    line-height: 1;
    min-height: 48px;
    transition: background var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out),
      transform var(--dur-1) var(--ease-out), box-shadow var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .btn--primary {
    background: var(--ke-orange-text);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--ke-orange-dark);
  }

  .btn--primary:active {
    transform: translateY(1px);
  }

  .btn--outline {
    background: transparent;
    color: var(--ke-ink);
    border-color: var(--ke-ink);
  }

  .btn--outline:hover {
    background: var(--ke-ink);
    color: var(--ke-bone);
  }

  .btn--lg {
    padding: 16px 22px;
    font-size: 16px;
    border-radius: var(--radius-3);
    min-height: 54px;
  }

  .hero__trust {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    color: var(--fg-2);
    font-size: 13px;
    font-weight: 600;
    align-items: center;
    margin-top: auto;
    padding-top: 32px;
  }

  .hero__trust span {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .hero__trust svg {
    width: 16px;
    height: 16px;
    color: var(--ke-clay);
    flex: none;
  }

  .dot {
    width: 3px;
    height: 3px;
    background: var(--ke-stone);
    border-radius: 50%;
    display: inline-block;
  }

  @media (max-width: 768px) {
    /* On a phone the offer line carries the message; the paragraph would push
       the call button under the fold. The sticky bar still has the number. */
    .hero__offer { font-size: 18px; max-width: none; margin-top: 22px; }
    .hero__lead { display: none; }
    .hero__offer + .hero__ctas, .hero__offer ~ .hero__ctas { margin-top: 22px; }
    .eyebrow {
      white-space: normal;
      line-height: 1.4;
    }

    .hero__trust {
      margin-top: 20px;
      padding-top: 0;
    }
  }
</style>

