---
import { siteContent } from '../../content/site';
import QuoteForm from '../ui/QuoteForm.astro';
---

<section class="final-cta" id="contact" aria-labelledby="cta-title">
  <div class="final-cta__inner">
    <div>
      <h2 id="cta-title" class="final-cta__title">
        Call Adam.<br/>
        <em>Get it done.</em>
      </h2>
      <p class="final-cta__lead">
        Free estimates. California C-10 licensed and insured. Owner-operated. Most non-emergency scheduling within a few business days.
      </p>
      <div class="final-cta__ctas">
        <a class="btn btn--primary btn--lg" href="tel:+18052860477">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/>
          </svg>
          Call (805) 286-0477
        </a>
        <a class="btn btn--outline-light btn--lg" href="sms:+18052860477">Text (805) 286-0477</a>
      </div>
    </div>

    <div class="final-cta__phone">
      <QuoteForm />
    </div>
  </div>
</section>

<style>
  .final-cta {
    background: var(--ke-ink);
    color: var(--ke-bone);
    position: relative;
    overflow: hidden;
    /* Jumping from the header "Get a quote" should clear the sticky header. */
    scroll-margin-top: 84px;
  }

  .final-cta::before {
    display: none;
  }

  .final-cta__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    padding: 88px var(--gutter);
    max-width: var(--max);
    margin: 0 auto;
  }

  .final-cta__title {
    font-family: var(--font-display);
    font-variation-settings: 'YEAR' 2050;
    font-size: clamp(44px, 5.6vw, 86px);
    line-height: 0.92;
    color: var(--ke-bone);
    margin: 14px 0 18px;
    letter-spacing: -0.005em;
  }

  .final-cta__title em {
    font-style: normal;
    color: var(--ke-orange);
  }

  .final-cta__lead {
    font-size: 18px;
    line-height: 1.55;
    color: rgba(246, 241, 232, 0.78);
    max-width: 46ch;
    margin: 0 0 32px;
    font-weight: 500;
  }

  .final-cta__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .final-cta__phone {
    background: var(--ke-bone);
    color: var(--ke-ink);
    border-radius: var(--radius-4);
    padding: 32px 30px;
    border: 1px solid rgba(246, 241, 232, 0.18);
    position: relative;
    overflow: hidden;
  }

  .btn {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 15px;
    padding: 13px 18px;
    border-radius: var(--radius-2);
    border: 1px solid transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    line-height: 1;
    min-height: 48px;
    transition: all var(--dur-1) var(--ease-out);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn svg {
    width: 18px;
    height: 18px;
    flex: none;
  }

  .btn--primary {
    background: var(--ke-orange-text);
    color: #fff;
  }

  .btn--primary:hover {
    background: var(--ke-orange-dark);
  }

  .btn--primary:active {
    transform: translateY(1px);
  }

  .btn--outline-light {
    background: transparent;
    color: var(--ke-bone);
    border-color: var(--ke-bone);
  }

  .btn--outline-light:hover {
    background: var(--ke-bone);
    color: var(--ke-ink);
  }

  .btn--lg {
    padding: 16px 22px;
    font-size: 16px;
    border-radius: var(--radius-3);
    min-height: 54px;
  }

  /* On desktop the copy and the estimate card sit side by side, so jumping to
     #contact lands on a visible form instead of scrolling past the headline. */
  @media (min-width: 960px) {
    .final-cta__inner {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
  }

  @media (max-width: 768px) {
    .final-cta__inner {
      padding: 80px var(--gutter);
      gap: 40px;
    }

    .final-cta__ctas {
      flex-direction: column;
    }

    .btn--lg {
      width: 100%;
    }
  }
</style>
