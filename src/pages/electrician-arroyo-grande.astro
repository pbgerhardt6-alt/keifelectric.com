---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReviewBadges from '../components/ui/ReviewBadges.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';

const title = 'Electrician in Arroyo Grande, CA | Keif Electric';
const description = "Residential electrician serving Arroyo Grande, CA. Panel upgrades, EV chargers, lighting, and repairs for Village-era homes, Rancho Grande tracts, and rural properties toward Huasna and Lopez Lake. C-10 licensed and insured. Free estimates.";
const canonical = 'https://keifelectric.com/electrician-arroyo-grande';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://keifelectric.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://keifelectric.com/#service-area' },
    { '@type': 'ListItem', position: 3, name: 'Arroyo Grande', item: 'https://keifelectric.com/electrician-arroyo-grande' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Does electrical work in Arroyo Grande require a permit?",
      acceptedAnswer: { '@type': 'Answer', text: "Permit requirements depend on the work. Inside city limits, the City lists panel upgrades as over-the-counter permits, typically processed in zero to three days, while larger electrical projects may need plan review. Permits go through the City of Arroyo Grande Community Development Department, Building Division, at 300 East Branch Street. For properties in unincorporated areas outside the City, permitting goes through San Luis Obispo County. I handle the permit and inspection process when one is required." },
    },
    {
      '@type': 'Question',
      name: "Do older Arroyo Grande homes have ungrounded wiring?",
      acceptedAnswer: { '@type': 'Answer', text: "Older homes around the Village often do. Two-prong outlets are a sign that the receptacle does not provide an equipment grounding contact, and in an older home the wiring behind it may be ungrounded or may be knob-and-tube or cloth-insulated. I inspect before recommending anything, then lay out options from GFCI protection on ungrounded circuits through to a staged rewire." },
    },
    {
      '@type': 'Question',
      name: "Can my electrical panel handle a new heat pump or AC?",
      acceptedAnswer: { '@type': 'Answer', text: "Sometimes yes, sometimes not, and it is worth answering before the equipment is ordered. I do a load calculation on the existing service first, so you know whether the panel is part of the project or not. A lot of homes here are adding cooling for the first time, which is exactly when this comes up." },
    },
    {
      '@type': 'Question',
      name: "Can you wire a well, barn, shop, or second dwelling?",
      acceptedAnswer: { '@type': 'Answer', text: "Yes. On acreage east of town that is most of the work: a well pump on its own protected circuit, a subpanel in a barn or shop fed by a properly sized run, and long feeders between buildings. Each building may need its own feeder, subpanel, or service depending on the setup." },
    },
    {
      '@type': 'Question',
      name: "Do you serve rural properties outside Arroyo Grande?",
      acceptedAnswer: { '@type': 'Answer', text: "Yes, including the properties along Huasna Road and east toward Lopez Lake. I also serve Grover Beach, Pismo Beach, and Oceano, and from my base in San Luis Obispo the rest of SLO County. Not sure I reach you? Call and ask." },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} includeFaqSchema={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main id="main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#service-area">Service Areas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Arroyo Grande</span>
      </div>
    </nav>

    <section class="svc-hero" id="top" aria-labelledby="page-h1">
      <div class="svc-hero__inner container">
        <div class="svc-hero__copy">
          <h1 id="page-h1" class="svc-hero__title">
            <span class="svc-hero__line">Electrician in</span>
            <span class="svc-hero__line svc-hero__line--accent">Arroyo Grande, CA<span class="svc-hero__dot" aria-hidden="true"></span></span>
          </h1>
          <p class="svc-hero__place">Residential electrical work from the Village to the hills and the rural properties east of town</p>
          <p class="svc-hero__sub">Panel upgrades, EV chargers, lighting, and troubleshooting from the Village to the hillside tracts to the ranches out Huasna Road. About twenty minutes from my base in SLO. I quote the job, I do the work, and I answer the phone.</p>
          <div class="svc-hero__ctas">
            <a class="btn btn--primary btn--lg" href="tel:+18052860477">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              Call (805) 286-0477
            </a>
            <a class="btn btn--outline btn--lg" href="sms:+18052860477">Text (805) 286-0477</a>
          </div>
          <p class="svc-hero__trust">California C-10 licensed &middot; Insured &middot; Serving Arroyo Grande, the Five Cities &amp; SLO</p>
          <ReviewBadges />
        </div>
        <aside class="svc-hero__card" aria-label="Request a free estimate">
          <div class="svc-hero__owner">
            <img class="svc-hero__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="eager" />
            <p class="svc-hero__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
          <QuoteForm city="Arroyo Grande" title="Request a free estimate" variant="hero" />
        </aside>
      </div>
    </section>

    <section class="content-section" aria-labelledby="handle-title">
      <div class="container container--prose">
        <h2 id="handle-title" class="section-title">Electrical work I handle in Arroyo Grande</h2>
        <p class="lead-copy">I'm Adam Keif, a C-10 licensed residential electrician based in San Luis Obispo. Arroyo Grande is about twenty minutes down the 101 and a regular part of my service area. It is a town with three very different kinds of housing, and the work splits along those lines: older homes around the Village, newer tracts on the hills, and rural properties east of town.</p>
        <ul class="feature-list">
          <li><strong>Troubleshooting.</strong> Breakers that trip when the AC starts, a dead circuit in an older house, an outlet that sparks. I find the cause instead of patching the symptom. <a href="/electrical-repair-san-luis-obispo" class="inline-link">Troubleshooting &amp; repair</a>.</li>
          <li><strong>Panel upgrades and replacements.</strong> Whether it is a Village home on a small original panel or a 1990s tract home that has run out of room, I handle the upgrade, the permit, and the inspection. <a href="/electrical-panel-upgrade-san-luis-obispo" class="inline-link">Panel upgrades</a>.</li>
          <li><strong>AC, heat pump, and appliance circuits.</strong> Arroyo Grande gets warmer summer temperatures than the immediate coast, and adding cooling is a common reason for an electrical upgrade. Dedicated equipment, a load check on the existing service, and a clean disconnect at the unit.</li>
          <li><strong>EV charger installation.</strong> Level 2 charging for commuters heading up to SLO or down to Santa Maria. I check the panel can support the load before quoting. <a href="/ev-charger-installation-san-luis-obispo" class="inline-link">EV charger installation</a>.</li>
          <li><strong>Lighting.</strong> Recessed lighting for remodels, exterior and landscape lighting for larger lots and long driveways, and period-appropriate fixtures for older homes. <a href="/lighting-installation-san-luis-obispo" class="inline-link">Recessed &amp; custom lighting</a>.</li>
          <li><strong>Old-home wiring.</strong> Ungrounded two-prong circuits, knob and tube, and cloth-wrapped wiring in homes from the Village era. Inspection first, then honest options from GFCI protection to a rewire.</li>
          <li><strong>Rural properties.</strong> Well pump circuits, subpanels for barns and shops, long feeder runs, and wiring for a second dwelling on acreage along Huasna Road and east of town.</li>
          <li><strong>Remodels and new construction.</strong> Kitchen and bath remodels, additions, ADUs, and full wiring for new builds, coordinated with your contractor. <a href="/new-construction-electrical-san-luis-obispo" class="inline-link">New construction &amp; remodels</a>.</li>
        </ul>
      </div>
    </section>

    <section class="content-section content-section--alt" aria-labelledby="homes-title">
      <div class="container container--prose">
        <h2 id="homes-title" class="section-title">Three kinds of Arroyo Grande homes</h2>
        <p>The Village is the old heart of town, and the homes on the streets around East Branch Street are some of the oldest I work on. Parts of the area are covered by the City's Historic Character Overlay District and its Village historic-district guidelines, which shape what you can change outside. Inside, it is often older panels, ungrounded two-prong outlets, and wiring that predates modern household electrical loads.</p>
        <p>Up the hill, neighborhoods such as Rancho Grande and Royal Oaks have many homes built in the 1990s and 2000s. Many of those have newer wiring and larger electrical services, but they were built before EV charging, heat pumps, and induction cooking became common household loads, so the panel is often full and the question is how to add load without replacing it.</p>
        <p>East of town the road turns rural. Along Huasna Road and out toward Lopez Lake it is larger parcels with a well, a septic system, a barn or a shop, and sometimes a second dwelling. Each building may need its own feeder, subpanel, or service depending on the setup, the well pump needs a properly protected circuit, and the runs between buildings are long. That is a different kind of electrical work.</p>
        <p>If you own a home in any of those three parts of town and are not sure what shape the electrical is in, that is a normal place to start. I can assess it and give you a straight answer about what needs attention now and what can wait.</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="loads-title">
      <div class="container container--prose">
        <h2 id="loads-title" class="section-title">Cooling loads, old wiring, and properties with a well</h2>
        <p>Three requests come up here more than in the coastal towns I serve.</p>
        <h3 class="sub-title">Adding AC or a heat pump</h3>
        <p>Arroyo Grande gets warmer summer temperatures than the immediate coast, and a lot of homes here were built without cooling. Adding a heat pump or central AC typically means dedicated electrical equipment, a disconnect at the unit, and a load calculation on the existing service before anything is ordered. Sometimes the panel has room. Sometimes it is at capacity and the honest answer is that the panel is part of the job. I tell you which before you commit.</p>
        <h3 class="sub-title">Wiring in Village-era homes</h3>
        <p>Two-prong outlets are a sign that the receptacle does not provide an equipment grounding contact. In an older home the underlying wiring may also be ungrounded, and there may be knob-and-tube or cloth-insulated wiring behind the plaster. Neither automatically means the house needs a full rewire, but both deserve an assessment before adding significant new loads or starting a remodel. I inspect the wiring first, then lay out real options: GFCI protection on ungrounded circuits, replacing the worst runs, or a rewire staged around your project.</p>
        <h3 class="sub-title">Wells, barns, and second dwellings</h3>
        <p>On acreage east of town, the electrical is spread across the property. A well pump on its own protected circuit. A subpanel in the barn or shop, fed by a properly sized run from the house. A second dwelling that may need its own service or subpanel and a permit through the County. I size the feeders for the distance, trench or run conduit, and set each building up to stand on its own.</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="howiwork-title">
      <div class="container container--prose">
        <h2 id="howiwork-title" class="section-title">How I work</h2>
        <p>You call or send a quote request. For simple repairs I can often quote by phone. For a panel upgrade, a heat pump circuit, or a rewire, I will come out and look, at no cost.</p>
        <p>You get a written quote before any work begins. Flat-rate where possible, no add-ons you did not agree to. For troubleshooting, I charge a diagnostic fee that applies toward the repair if you move forward.</p>
        <p>Permit requirements depend on the work. Inside city limits, permits go through the City of Arroyo Grande Community Development Department, Building Division, at 300 East Branch Street. The City lists panel upgrades as over-the-counter permits, typically processed in zero to three days, while larger electrical projects may need plan review. For properties in unincorporated areas outside the City, permits go through San Luis Obispo County. Either way, I pull the permit and handle the inspection when one is required.</p>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="container container--prose">
        <h2 id="why-title" class="section-title">Why Arroyo Grande homeowners hire Keif Electric</h2>
        <ul class="why-list">
          <li><strong>You hire me, not a crew.</strong> The person who quotes your job is the person who does it.</li>
          <li><strong>Licensed and insured.</strong> California C-10, CA# 1152084.</li>
          <li><strong>Honest about scope.</strong> If you don't need a full upgrade, I'll tell you. If you do, I'll show you why.</li>
          <li><strong>Clean, labeled work.</strong> Panels left neat and every circuit labeled, so the next person who opens it knows what's what.</li>
        </ul>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="container">
        <div class="faq-inner">
          <aside class="faq-sidebar">
            <h2 id="faq-title" class="faq-sidebar__title">Arroyo Grande FAQ</h2>
            <p>Have something else? Call and ask.</p>
            <a href="tel:+18052860477" class="btn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              (805) 286-0477
            </a>
          </aside>
          <div class="faq-list">
            <details class="faq-item" open>
              <summary class="faq-item__btn"><span>Does electrical work in Arroyo Grande require a permit?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Permit requirements depend on the work. Inside city limits, the City lists panel upgrades as over-the-counter permits, typically processed in zero to three days, while larger electrical projects may need plan review. Permits go through the City of Arroyo Grande Community Development Department, Building Division, at 300 East Branch Street. For properties in unincorporated areas outside the City, permitting goes through San Luis Obispo County. I handle the permit and inspection process when one is required.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Do older Arroyo Grande homes have ungrounded wiring?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Older homes around the Village often do. Two-prong outlets are a sign that the receptacle does not provide an equipment grounding contact, and in an older home the wiring behind it may be ungrounded or may be knob-and-tube or cloth-insulated. I inspect before recommending anything, then lay out options from GFCI protection on ungrounded circuits through to a staged rewire.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Can my electrical panel handle a new heat pump or AC?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Sometimes yes, sometimes not, and it is worth answering before the equipment is ordered. I do a load calculation on the existing service first, so you know whether the panel is part of the project or not. A lot of homes here are adding cooling for the first time, which is exactly when this comes up.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Can you wire a well, barn, shop, or second dwelling?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Yes. On acreage east of town that is most of the work: a well pump on its own protected circuit, a subpanel in a barn or shop fed by a properly sized run, and long feeders between buildings. Each building may need its own feeder, subpanel, or service depending on the setup.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Do you serve rural properties outside Arroyo Grande?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Yes, including the properties along Huasna Road and east toward Lopez Lake. I also serve Grover Beach, Pismo Beach, and Oceano, and from my base in <a href="/electrician-san-luis-obispo" class="inline-link">San Luis Obispo</a> the rest of SLO County. Not sure I reach you? Call and ask.</p></div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="page-cta" id="contact" aria-labelledby="cta-title">
      <div class="container">
        <div class="page-cta__inner">
          <div class="page-cta__copy">
            <h2 id="cta-title" class="page-cta__title"><span class="page-cta__call">Call</span><a class="page-cta__num" href="tel:+18052860477">(805) 286-0477</a></h2>
            <p class="page-cta__lead">I quote the job myself, pull the permit when one is required, and do the work. Arroyo Grande is about twenty minutes down the 101 from my base in San Luis Obispo.</p>
            <a class="page-cta__alt" href="sms:+18052860477">Or text me at the same number.</a>
            <ul class="page-cta__facts">
              <li>California C-10 #1152084</li>
              <li>Liability insured</li>
              <li>Mon&ndash;Fri, 9am&ndash;5pm</li>
            </ul>
          </div>
          <div class="page-cta__card">
            <div class="page-cta__owner">
            <img class="page-cta__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="lazy" />
            <p class="page-cta__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
            <QuoteForm city="Arroyo Grande" title="Or send it and I will call you" variant="hero" />
          </div>
        </div>
      </div>
    </section>

  </main>

  <noscript>
    <style>
      .content-section .container--prose,
      .why-section .container--prose,
      .proof-placeholder .container,
      .faq-inner,
    </style>
  </noscript>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .container--prose { max-width: 760px; }
  .breadcrumb { background: var(--ke-bone); border-bottom: 1px solid var(--border-1); padding: 12px 0; }
  .breadcrumb .container { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--fg-2); }
  .breadcrumb a { color: var(--ke-orange-text); font-weight: 500; }
  .breadcrumb a:hover { text-decoration: underline; }
  .svc-hero { position: relative; background: var(--ke-bone); overflow: hidden; padding: 72px 0 88px; }
  .svc-hero::before { content: ''; position: absolute; top: -25%; right: -12%; width: 62%; height: 130%; background: radial-gradient(closest-side, rgba(243, 152, 31, 0.12), transparent 72%); pointer-events: none; }
  .svc-hero__inner { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .svc-hero__title { font-family: var(--font-sans); font-weight: 800; font-size: clamp(38px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.025em; color: var(--ke-ink); margin: 0; }
  .svc-hero__line { display: block; }
  .svc-hero__line--accent { color: var(--ke-orange); }
  .svc-hero__dot { display: inline-block; width: 0.16em; height: 0.16em; background: var(--ke-orange); border-radius: 2px; margin-left: 0.05em; vertical-align: baseline; }
  .svc-hero__place { display: block; font-family: var(--font-sans); font-weight: 600; font-size: clamp(15px, 1.6vw, 19px); letter-spacing: 0; color: var(--fg-2); margin: 16px 0 0; }
  .svc-hero__sub { font-size: 18px; line-height: 1.55; color: var(--ke-ink); max-width: 46ch; margin: 22px 0 26px; font-weight: 500; }
  .svc-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .svc-hero__trust { margin-top: 26px; font-size: 13px; font-weight: 600; color: var(--fg-2); letter-spacing: 0.01em; }
  .svc-hero__card { justify-self: end; width: 100%; max-width: 460px; background: #fff; border: 1px solid var(--border-1); border-radius: var(--radius-4); box-shadow: var(--shadow-3); padding: 24px 24px 22px; }
  .svc-hero__owner { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border-1); }
  .svc-hero__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 50% 12%; flex: none; border: 2px solid var(--ke-bone); box-shadow: 0 0 0 1px var(--border-1); }
  .svc-hero__owner-text { margin: 0; font-size: 14px; line-height: 1.45; color: var(--fg-2); }
  .svc-hero__owner-text strong { color: var(--ke-ink); }
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__line, .svc-hero__place, .svc-hero__sub, .svc-hero__ctas, .svc-hero__trust, .svc-hero__card { opacity: 0; animation: heroIn 0.8s var(--ease-emph) forwards; }
    .svc-hero__line:nth-child(1) { animation-delay: 0.13s; }
    .svc-hero__line:nth-child(2) { animation-delay: 0.21s; }
    .svc-hero__place { animation-delay: 0.29s; }
    .svc-hero__sub { animation-delay: 0.37s; }
    .svc-hero__ctas { animation-delay: 0.45s; }
    .svc-hero__trust { animation-delay: 0.53s; }
    .svc-hero__card { animation-delay: 0.22s; animation-duration: 1s; }
    .content-section .container--prose, .why-section .container--prose, .proof-placeholder .container, .faq-inner { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease-emph), transform 0.7s var(--ease-emph); }
    .is-in { opacity: 1 !important; transform: none !important; }
  }
  @keyframes heroIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .btn { font-family: var(--font-sans); font-weight: 600; font-size: 15px; padding: 13px 18px; border-radius: var(--radius-2); border: 1px solid transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 9px; line-height: 1; min-height: 48px; transition: all var(--dur-1) var(--ease-out); text-decoration: none; white-space: nowrap; }
  .btn svg { width: 18px; height: 18px; flex: none; }
  .btn--primary { background: var(--ke-orange); color: #fff; }
  .btn--outline { background: transparent; color: var(--ke-ink); border: 1.5px solid var(--ke-ink); }
  .btn--outline:hover { background: var(--ke-ink); color: var(--ke-bone); }
  .btn--primary:hover { background: var(--ke-orange-dark); }
  .btn--primary:active { transform: translateY(1px); }
  .btn--outline-light { background: transparent; color: var(--ke-bone); border-color: rgba(246, 241, 232, 0.4); }
  .btn--outline-light:hover { background: rgba(246, 241, 232, 0.08); border-color: var(--ke-bone); }
  .btn--lg { padding: 16px 22px; font-size: 16px; border-radius: var(--radius-3); min-height: 54px; }
  .btn-link { display: inline-flex; align-items: center; gap: 8px; color: var(--ke-orange); font-weight: 600; font-size: 15px; text-decoration: none; }
  .btn-link svg { width: 16px; height: 16px; }
  .btn-link:hover { text-decoration: underline; }
  .content-section { padding: 80px 0; background: var(--ke-bone); }
  .content-section--alt { background: var(--ke-paper); }
