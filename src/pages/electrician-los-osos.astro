---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReviewBadges from '../components/ui/ReviewBadges.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';

const title = 'Electrician in Los Osos, CA | Keif Electric';
const description = "Residential electrician serving Los Osos and Baywood Park, CA. Panel upgrades, EV chargers, lighting, and repairs for 1960s to 1990s homes in salt air. C-10 licensed and insured. Free estimates.";
const canonical = 'https://keifelectric.com/electrician-los-osos';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://keifelectric.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://keifelectric.com/#service-area' },
    { '@type': 'ListItem', position: 3, name: 'Los Osos', item: 'https://keifelectric.com/electrician-los-osos' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Does electrical work in Los Osos require a permit?",
      acceptedAnswer: { '@type': 'Answer', text: "Permit requirements depend on the work. Panel replacements, EV chargers, and many new electrical installations require one. Los Osos is unincorporated, so permits are handled through San Luis Obispo County Planning & Building rather than a city building department. I handle the permit and inspection process when one is required." },
    },
    {
      '@type': 'Question',
      name: "Why do electrical panels in Los Osos have corrosion problems?",
      acceptedAnswer: { '@type': 'Answer', text: "Los Osos is a coastal community, and salt air and moisture are hard on exterior electrical equipment. Surface rust on a panel door is different from corrosion inside the enclosure, at the bus bars, or at the connections. I can inspect the panel and tell you which one you have and what needs attention." },
    },
    {
      '@type': 'Question',
      name: "Should I be concerned about aluminum wiring in my Los Osos home?",
      acceptedAnswer: { '@type': 'Answer', text: "Some homes built or rewired during the late 1960s and early 1970s used aluminum branch-circuit wiring, and Los Osos added a lot of housing in those years. It does not automatically mean you need a full rewire. I can inspect the wiring, tell you what condition it is in, and recommend an approved repair method or replacement where it is warranted." },
    },
    {
      '@type': 'Question',
      name: "Can I install a generator at my Los Osos home?",
      acceptedAnswer: { '@type': 'Answer', text: "Yes. For many homes a portable generator with a properly installed interlock or manual transfer switch is enough to run essential loads such as a refrigerator, a pump, lights, and selected outlets safely, without backfeeding the utility lines. The right setup depends on what you want to keep running and the electrical service at your home." },
    },
    {
      '@type': 'Question',
      name: "What areas do you serve?",
      acceptedAnswer: { '@type': 'Answer', text: "Los Osos and Baywood Park, plus Morro Bay, and from my base in San Luis Obispo the rest of SLO County. Not sure I reach you? Call and ask." },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} includeFaqSchema={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main id="main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#service-area">Service Areas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Los Osos</span>
      </div>
    </nav>

    <section class="svc-hero" id="top" aria-labelledby="page-h1">
      <div class="svc-hero__inner container">
        <div class="svc-hero__copy">
          <h1 id="page-h1" class="svc-hero__title">
            <span class="svc-hero__line">Electrician in</span>
            <span class="svc-hero__line svc-hero__line--accent">Los Osos, CA<span class="svc-hero__dot" aria-hidden="true"></span></span>
          </h1>
          <p class="svc-hero__place">Residential electrical work for Los Osos and Baywood Park</p>
          <p class="svc-hero__sub">Panel upgrades, EV chargers, lighting, and troubleshooting for the older homes of Los Osos and Baywood Park. About fifteen minutes from my base in SLO. I quote the job, I do the work, and I answer the phone.</p>
          <div class="svc-hero__ctas">
            <a class="btn btn--primary btn--lg" href="tel:+18052860477">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              Call (805) 286-0477
            </a>
            <a class="btn btn--outline btn--lg" href="sms:+18052860477">Text (805) 286-0477</a>
          </div>
          <p class="svc-hero__trust">California C-10 licensed &middot; Insured &middot; Serving Los Osos, Baywood Park &amp; SLO</p>
