---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReviewBadges from '../components/ui/ReviewBadges.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';

const title = 'ADU Electrical in San Luis Obispo County | Keif Electric';
const description = 'ADU electrical in San Luis Obispo County. Load calculations, subpanels, separate services, and full ADU wiring rough-in to finish. Owner-operated, C-10 licensed. Free estimates.';
const canonical = 'https://keifelectric.com/adu-electrical-san-luis-obispo';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ADU Electrical',
  description: 'Electrical for accessory dwelling units: load calculations on the existing service, subpanel or separate service, feeders and trenching, and full ADU wiring from rough-in to finish. Permitted and inspected. Serving San Luis Obispo County.',
  url: canonical,
  image: 'https://keifelectric.com/assets/service-newbuild.jpg',
  provider: { '@id': 'https://keifelectric.com/#business' },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'San Luis Obispo County, CA',
  },
  serviceType: 'ADU Electrical',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://keifelectric.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://keifelectric.com/#services' },
    { '@type': 'ListItem', position: 3, name: 'ADU Electrical', item: canonical },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "Can my existing panel and service handle an ADU?",
      acceptedAnswer: { '@type': 'Answer', text: "That is the first question to answer, and it is worth answering before the plans are final. An ADU is a complete dwelling: kitchen circuits, bathroom GFCI protection, heating and cooling, laundry, and its own load. I run a load calculation on the existing service and tell you whether it carries the unit as-is, needs an upgrade first, or the ADU needs its own service." },
    },
    {
      '@type': 'Question',
      name: "Does an ADU need its own electrical meter?",
      acceptedAnswer: { '@type': 'Answer', text: "Not always, and it is worth checking early because it affects cost and schedule. California law limits when a local agency can require a separate utility connection or meter for a qualifying ADU, and the utility applies its own requirements, which often turn on whether the unit is detached, attached, or a conversion of existing space. I confirm the requirement with PG&E and the local building department for your specific project rather than assuming." },
    },
    {
      '@type': 'Question',
      name: "When should an electrician be involved in an ADU project?",
      acceptedAnswer: { '@type': 'Answer', text: "Earlier than most people expect. A load calculation and the subpanel-or-separate-service decision belong in the design phase, because both can change the drawings, the budget, and the utility timeline. Bringing me in at rough-in means those questions get answered when it is expensive to change the answer." },
    },
    {
      '@type': 'Question',
      name: "Can you wire a prefab or modular ADU?",
      acceptedAnswer: { '@type': 'Answer', text: "Yes, and pre-reviewed plan sets too. San Luis Obispo County offers pre-reviewed ADU designs, and prefab and modular units are common here. The unit itself may arrive largely wired, but the site work is still a project: the feeder from the house or a new service, trenching, the disconnect, grounding, and tying it into a panel that can actually carry it." },
    },
    {
      '@type': 'Question',
      name: "Do you work with ADU contractors and owner-builders?",
      acceptedAnswer: { '@type': 'Answer', text: "Yes, regularly. I sub for contractors and owner-builders on ADUs across SLO County, from full rough-in through finish trim, coordinated to your schedule. If you build ADUs and want an electrician who quotes the job and then shows up to do it, call me." },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} includeFaqSchema={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main id="main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#services">Services</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">ADU electrical</span>
      </div>
    </nav>

    <section class="svc-hero" id="top" aria-labelledby="page-h1">
      <div class="svc-hero__inner container">
        <div class="svc-hero__copy">
          <p class="svc-hero__eyebrow">
            <svg class="svc-hero__spark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
            ADU Electrical
          </p>
          <h1 id="page-h1" class="svc-hero__title">
            <span class="svc-hero__line">ADU electrical</span>
            <span class="svc-hero__line svc-hero__line--accent">wiring &amp; power<span class="svc-hero__dot" aria-hidden="true"></span></span>
            <span class="svc-hero__place">in San Luis Obispo County</span>
          </h1>
          <p class="svc-hero__sub">Load calculations, subpanels, separate services, and full ADU wiring from rough-in through finish. I tell you whether your existing service can carry the unit before the plans are final.</p>
          <div class="svc-hero__ctas">
            <a class="btn btn--primary btn--lg" href="tel:+18052860477">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              Call (805) 286-0477
            </a>
            <a class="btn btn--outline btn--lg" href="sms:+18052860477">Text (805) 286-0477</a>
          </div>
          <p class="svc-hero__trust">California C-10 licensed &middot; Insured &middot; Serving SLO, Atascadero &amp; Paso Robles</p>
          <ReviewBadges />
        </div>
        <aside class="svc-hero__card" aria-label="Request a free estimate">
          <div class="svc-hero__owner">
            <img class="svc-hero__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="eager" />
            <p class="svc-hero__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
          <p class="svc-hero__fact"><strong>Load check first</strong> Know what your service can support before the plans are final.</p>
          <QuoteForm title="Request a free estimate" variant="hero" />
        </aside>
      </div>
    </section>

    <section class="content-section" aria-labelledby="handle-title">
      <div class="container container--prose">
        <h2 id="handle-title" class="section-title">What an ADU needs electrically</h2>
        <p class="lead-copy">I'm Adam Keif, a C-10 licensed residential electrician based in San Luis Obispo. An ADU is not a scaled-down house. It is a complete dwelling in a small footprint, and it has to get its power from a property that was wired for one home. That is where most of the real decisions are.</p>
        <ul class="feature-list">
          <li><strong>A load calculation on the existing service.</strong> The first question is whether what you already have can carry a second dwelling. I run the numbers rather than guessing, and I would rather tell you in the design phase than after the drawings are done.</li>
          <li><strong>Subpanel or a separate service.</strong> The unit either runs off a subpanel fed from the existing service or gets its own. That single decision moves the cost, the permit, and the utility timeline more than anything else on the electrical scope.</li>
          <li><strong>The feeder and the trench.</strong> For a detached unit, power has to physically get there. Feeder sized for the load and the distance, conduit or direct burial, trench depth to code, and a disconnect where it belongs.</li>
          <li><strong>A panel upgrade, when the numbers say so.</strong> Adding a dwelling is frequently what pushes an older service past what it can carry. <a href="/electrical-panel-upgrade-san-luis-obispo" class="inline-link">Panel upgrades</a>.</li>
          <li><strong>Full interior wiring, rough-in to trim.</strong> Kitchen circuits, bathroom GFCI protection, heating and cooling, laundry, smoke and carbon monoxide detection, lighting, and exterior fixtures. A whole house worth of circuits in a few hundred square feet.</li>
          <li><strong>Title 24 and electric-ready requirements.</strong> New ADUs carry energy-code requirements that can affect the electrical design, including electric-ready and battery-storage-ready provisions. I account for those when planning the service, the panel, and the wiring, so the system is not designed around yesterday’s load.</li>
          <li><strong>Permits and inspection.</strong> Pulled and scheduled as part of the job, through the City or the County depending on where the property sits.</li>
        </ul>
      </div>
    </section>

    <section class="content-section content-section--alt" aria-labelledby="power-title">
      <div class="container container--prose">
        <h2 id="power-title" class="section-title">Subpanel or a separate meter?</h2>
        <p>This is one of the first electrical decisions worth settling, because it can affect the budget, the drawings, the permit, and the utility timeline.</p>
        <p><strong>Attached or detached, the question is the same:</strong> what does the unit require, and can the existing service support it? A detached unit adds a feeder and a trench to get power across the property. An attached unit or a conversion of existing space skips that, but can bring its own constraints depending on how the space was wired and where the service enters.</p>
        <h3 class="sub-title">Running off the existing service</h3>
        <p>If the existing service has capacity, the cleanest answer is usually a subpanel in the ADU, fed from the main house. One utility account, no new meter, and the work stays on your property and your schedule. The constraint is capacity: a load calculation has to show the existing service can carry the house and the new dwelling together. On a property still running an older, smaller service, it often cannot, and then a panel upgrade comes first.</p>
        <h3 class="sub-title">Giving the ADU its own service</h3>
        <p>A separate service means its own meter and its own utility account, which some owners want for a rental. It also means involving PG&amp;E, and that is the part that adds time. Utility engineering review and crew scheduling run on their own calendar, not yours, so if a new service is the answer it should be identified early rather than discovered late.</p>
        <h3 class="sub-title">What decides it</h3>
        <p>Partly the numbers, partly the rules. California law limits when a local agency can require a separate utility connection or meter for an ADU, but the utility has its own requirements, and those often depend on whether the unit is detached, attached, or a conversion of existing space. Rather than assume, I confirm the requirement with PG&amp;E and the building department for your specific project, then size and price the work around the real answer.</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="rules-title">
      <div class="container container--prose">
        <h2 id="rules-title" class="section-title">California opened ADUs up. The service still has to carry it.</h2>
        <p>California and San Luis Obispo County have made ADUs easier to build in several ways, and the County updated its ADU regulations in 2025. None of that tells you whether a given property’s electrical service can support the unit.</p>
        <p>Two properties on the same street, both approved for an ADU, can have completely different electrical scopes and costs depending on the age and size of the existing service. That gap is where I am useful, and it is worth closing before the design is locked.</p>
        <p>Your designer, builder, or planner is the right person for zoning and ADU requirements, and you should confirm the current rules with the jurisdiction that will issue the permit. My job is to work out what the electrical system needs to make the approved design work.</p>
      </div>
    </section>

    <section class="content-section content-section--alt" aria-labelledby="gc-title">
      <div class="container container--prose">
        <h2 id="gc-title" class="section-title">For contractors and owner-builders</h2>
        <p>I also work as a sub for ADU contractors and owner-builders. If you build ADUs, here is how I work and what makes the electrical go smoothly.</p>
        <p><strong>Bring me in during design, not at rough-in.</strong> The load calculation and the service decision belong on the drawings. When they get answered late, the fix is either a panel upgrade nobody budgeted for or a utility application that holds up the schedule.</p>
        <p><strong>What I need from you.</strong> The plan set, the appliance and mechanical schedule, and whether the unit is intended to be separately metered. From that I can give you a real number instead of an allowance.</p>
        <p><strong>What you get.</strong> One person who quotes the job and then does it. Rough-in coordinated to your framing schedule, trim when you are ready for it, permits pulled and inspections scheduled, and a panel left labeled so the final walkthrough is not an argument. If the schedule slips, you tell me directly. See <a href="/new-construction-electrical-san-luis-obispo" class="inline-link">new construction &amp; remodels</a> for how I handle full builds.</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="howiwork-title">
      <div class="container container--prose">
        <h2 id="howiwork-title" class="section-title">How I work</h2>
        <p>You call or send a quote request with whatever you have, even if it is just an idea and an address. For an ADU I will come out and look at the existing service at no cost, because that visit is what makes the rest of the numbers real.</p>
        <p>You get a written quote before any work begins. Flat-rate where possible, no add-ons you did not agree to.</p>
        <p>Permit requirements depend on the work and the jurisdiction. ADU wiring, new services, and panel upgrades commonly require permits, and those go through the city where the property sits or through San Luis Obispo County Planning &amp; Building for unincorporated areas. When the work requires a permit, I pull it and handle the inspection.</p>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="container container--prose">
        <h2 id="why-title" class="section-title">Why ADU owners and builders hire Keif Electric</h2>
        <ul class="why-list">
          <li><strong>Owner-operated.</strong> You get me on your job, not a rotating crew.</li>
          <li><strong>Licensed and insured.</strong> California C-10, CA# 1152084.</li>
          <li><strong>Reliable on schedule.</strong> Rough-in stays on pace; I don't hold up the build.</li>
          <li><strong>Clean, code-compliant finish.</strong> Labeled panels, tidy work, passes inspection.</li>
        </ul>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="container">
        <div class="faq-inner">
          <aside class="faq-sidebar">
            <span class="eyebrow">Questions</span>
            <h2 id="faq-title" class="faq-sidebar__title">ADU electrical FAQ</h2>
            <p>Have something else? Call and ask.</p>
            <a href="tel:+18052860477" class="btn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              (805) 286-0477
            </a>
          </aside>
          <div class="faq-list">
            <details class="faq-item" open>
              <summary class="faq-item__btn"><span>Can my existing panel and service handle an ADU?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>That is the first question to answer, and it is worth answering before the plans are final. An ADU is a complete dwelling: kitchen circuits, bathroom GFCI protection, heating and cooling, laundry, and its own load. I run a load calculation on the existing service and tell you whether it carries the unit as-is, needs an upgrade first, or the ADU needs its own service.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Does an ADU need its own electrical meter?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Not always, and it is worth checking early because it affects cost and schedule. California law limits when a local agency can require a separate utility connection or meter for a qualifying ADU, and the utility applies its own requirements, which often turn on whether the unit is detached, attached, or a conversion of existing space. I confirm the requirement with PG&amp;E and the local building department for your specific project rather than assuming.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>When should an electrician be involved in an ADU project?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Earlier than most people expect. A load calculation and the subpanel-or-separate-service decision belong in the design phase, because both can change the drawings, the budget, and the utility timeline. Bringing me in at rough-in means those questions get answered when it is expensive to change the answer.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Can you wire a prefab or modular ADU?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Yes, and pre-reviewed plan sets too. San Luis Obispo County offers pre-reviewed ADU designs, and prefab and modular units are common here. The unit itself may arrive largely wired, but the site work is still a project: the feeder from the house or a new service, trenching, the disconnect, grounding, and tying it into a panel that can actually carry it.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Do you work with ADU contractors and owner-builders?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Yes, regularly. I sub for contractors and owner-builders on ADUs across SLO County, from full rough-in through finish trim, coordinated to your schedule. If you build ADUs and want an electrician who quotes the job and then shows up to do it, call me.</p></div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="page-cta" id="contact" aria-labelledby="cta-title">
      <div class="container">
        <div class="page-cta__inner">
          <div class="page-cta__copy">
            <span class="eyebrow eyebrow--amber">Planning an ADU?</span>
            <h2 id="cta-title" class="page-cta__title"><span class="page-cta__call">Call</span><a class="page-cta__num" href="tel:+18052860477">(805) 286-0477</a></h2>
            <p class="page-cta__lead">Tell me the address and what you are planning. I will look at the existing service and tell you what the ADU actually needs, before the drawings are locked.</p>
            <a class="page-cta__alt" href="sms:+18052860477">Or text me at the same number.</a>
            <ul class="page-cta__facts">
              <li>California C-10 #1152084</li>
              <li>Liability insured</li>
              <li>Mon&ndash;Fri, 9am&ndash;5pm</li>
            </ul>
          </div>
          <div class="page-cta__card">
            <div class="page-cta__owner">
            <img class="page-cta__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="lazy" />
            <p class="page-cta__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
            <QuoteForm title="Or send it and I will call you" variant="hero" />
          </div>
        </div>
      </div>
    </section>

  </main>

  <noscript>
    <style>
      .content-section .container--prose,
      .why-section .container--prose,
      .proof-placeholder .container,
      .faq-inner,
    </style>
  </noscript>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .container--prose { max-width: 760px; }
  .breadcrumb { background: var(--ke-bone); border-bottom: 1px solid var(--border-1); padding: 12px 0; }
  .breadcrumb .container { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--fg-2); }
  .breadcrumb a { color: var(--ke-orange-text); font-weight: 500; }
  .breadcrumb a:hover { text-decoration: underline; }
  .svc-hero { position: relative; background: var(--ke-bone); overflow: hidden; padding: 72px 0 88px; }
  .svc-hero::before { content: ''; position: absolute; top: -25%; right: -12%; width: 62%; height: 130%; background: radial-gradient(closest-side, rgba(243, 152, 31, 0.12), transparent 72%); pointer-events: none; }
  .svc-hero__inner { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .svc-hero__eyebrow { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ke-clay); margin-bottom: 18px; }
  .svc-hero__spark { width: 15px; height: 15px; color: var(--ke-orange); }
  .svc-hero__title { font-family: var(--font-sans); font-weight: 800; font-size: clamp(38px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.025em; color: var(--ke-ink); margin: 0; }
  .svc-hero__line { display: block; }
  .svc-hero__line--accent { color: var(--ke-orange); }
  .svc-hero__dot { display: inline-block; width: 0.16em; height: 0.16em; background: var(--ke-orange); border-radius: 2px; margin-left: 0.05em; vertical-align: baseline; }
  .svc-hero__place { display: block; font-family: var(--font-sans); font-weight: 600; font-size: clamp(15px, 1.6vw, 19px); letter-spacing: 0; color: var(--fg-2); margin: 16px 0 0; }
  .svc-hero__sub { font-size: 18px; line-height: 1.55; color: var(--ke-ink); max-width: 46ch; margin: 26px 0 26px; font-weight: 500; }
  .svc-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .svc-hero__trust { margin-top: 26px; font-size: 13px; font-weight: 600; color: var(--fg-2); letter-spacing: 0.01em; }
  .svc-hero__card { justify-self: end; width: 100%; max-width: 460px; background: #fff; border: 1px solid var(--border-1); border-radius: var(--radius-4); box-shadow: var(--shadow-3); padding: 24px 24px 22px; }
  .svc-hero__owner { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border-1); }
  .svc-hero__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 50% 12%; flex: none; border: 2px solid var(--ke-bone); box-shadow: 0 0 0 1px var(--border-1); }
  .svc-hero__owner-text { margin: 0; font-size: 14px; line-height: 1.45; color: var(--fg-2); }
  .svc-hero__owner-text strong { color: var(--ke-ink); }
  .svc-hero__fact { display: block; margin: -4px 0 16px; padding: 9px 12px; background: var(--ke-bone); border-radius: var(--radius-2); font-size: 13px; line-height: 1.45; color: var(--fg-2); }
  .svc-hero__fact strong { margin-right: 4px; }
  .svc-hero__fact strong { color: var(--ke-ink); font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__eyebrow, .svc-hero__line, .svc-hero__place, .svc-hero__sub, .svc-hero__ctas, .svc-hero__trust, .svc-hero__card { opacity: 0; animation: heroIn 0.8s var(--ease-emph) forwards; }
    .svc-hero__eyebrow { animation-delay: 0.05s; }
    .svc-hero__line:nth-child(1) { animation-delay: 0.13s; }
    .svc-hero__line:nth-child(2) { animation-delay: 0.21s; }
    .svc-hero__place { animation-delay: 0.29s; }
    .svc-hero__sub { animation-delay: 0.37s; }
    .svc-hero__ctas { animation-delay: 0.45s; }
    .svc-hero__trust { animation-delay: 0.53s; }
    .svc-hero__card { animation-delay: 0.22s; animation-duration: 1s; }
    .content-section .container--prose, .why-section .container--prose, .proof-placeholder .container, .faq-inner { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease-emph), transform 0.7s var(--ease-emph); }
    .is-in { opacity: 1 !important; transform: none !important; }
