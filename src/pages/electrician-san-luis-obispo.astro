---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReviewBadges from '../components/ui/ReviewBadges.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';

const title = 'Residential Electrician in San Luis Obispo, CA | Keif Electric';
const description = 'Residential electrician based in San Luis Obispo. Panel upgrades, EV chargers, lighting, and troubleshooting for older downtown homes, mid-century neighborhoods, and newer builds. C-10 licensed and insured. Free estimates.';
const canonical = 'https://keifelectric.com/electrician-san-luis-obispo';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://keifelectric.com/' },
    { '@type': 'ListItem', position: 2, name: 'Service Areas', item: 'https://keifelectric.com/#service-area' },
    { '@type': 'ListItem', position: 3, name: 'San Luis Obispo', item: 'https://keifelectric.com/electrician-san-luis-obispo' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Do I need a permit for electrical work in San Luis Obispo?',
      acceptedAnswer: { '@type': 'Answer', text: 'For panel upgrades, new circuits, EV charger installs, and ADU wiring, yes. Inside city limits that goes through the City of San Luis Obispo Building and Safety Division at 919 Palm Street. If your address is in an unincorporated part of the county, it goes through SLO County instead, at 1585 Kansas Avenue. I figure out which one applies to your address and handle the filing and inspection scheduling.' },
    },
    {
      '@type': 'Question',
      name: 'Are there rebates for EV charger installation in San Luis Obispo?',
      acceptedAnswer: { '@type': 'Answer', text: 'Usually, yes. Most of San Luis Obispo is in 3CE territory, and their Electrify Your Ride program covers Level 2 chargers, installation, and the electrical work needed to get ready for one. PG&E runs its own residential charging rebates on top of that. The federal tax credit for EV chargers ended on June 30, 2026, so that one is no longer available. Amounts and eligibility windows change, sometimes more than once a year, so I\'d rather tell you what\'s actually current when you call than post a number here that goes stale.' },
    },
    {
      '@type': 'Question',
      name: 'My house is older. Can the panel handle an EV charger?',
      acceptedAnswer: { '@type': 'Answer', text: 'Depends what\'s in there. Plenty of older San Luis Obispo homes are still on 100-amp service, which may or may not have room depending on what else it\'s feeding. Some panels need replacing before anything else happens, especially older Federal Pacific and Zinsco equipment. I check the panel and do the load calculation before quoting, so the number you get includes whatever the job actually needs.' },
    },
    {
      '@type': 'Question',
      name: 'Do you work on rental properties?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. San Luis Obispo has a lot of rental housing and a lot of owners who don\'t live locally. I document the work so you have a record. Unpermitted electrical work is a real liability on a rental, so I permit what needs permitting.' },
    },
    {
      '@type': 'Question',
      name: 'Where are you based?',
      acceptedAnswer: { '@type': 'Answer', text: 'San Luis Obispo. That\'s my home and my service area, and I cover Paso Robles, Atascadero, Templeton, Santa Margarita, Morro Bay, Los Osos, and the surrounding county from here.' },
    },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} includeFaqSchema={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Header />

  <main id="main">

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <div class="container">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/#service-area">Service Areas</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">San Luis Obispo</span>
      </div>
    </nav>

    <section class="svc-hero" id="top" aria-labelledby="page-h1">
      <div class="svc-hero__inner container">
        <div class="svc-hero__copy">
          <p class="svc-hero__eyebrow">
            <svg class="svc-hero__spark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
            Service Area
          </p>
          <h1 id="page-h1" class="svc-hero__title">
            <span class="svc-hero__line">Residential Electrician in</span>
            <span class="svc-hero__line svc-hero__line--accent">San Luis Obispo<span class="svc-hero__dot" aria-hidden="true"></span></span>
            <span class="svc-hero__place">Owner-operated by Adam Keif</span>
          </h1>
          <p class="svc-hero__sub">I live and work in San Luis Obispo. Every job is done by me personally, no subcontractors, no handoffs. C-10 licensed, insured, free estimates.</p>
          <div class="svc-hero__ctas">
            <a class="btn btn--primary btn--lg" href="tel:+18052860477">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              Call (805) 286-0477
            </a>
            <a class="btn btn--outline btn--lg" href="sms:+18052860477">Text (805) 286-0477</a>
          </div>
          <p class="svc-hero__trust">California C-10 #1152084 &middot; Insured &middot; Based in SLO</p>
          <ReviewBadges />
        </div>
        <aside class="svc-hero__card" aria-label="Request a free estimate">
          <div class="svc-hero__owner">
            <img class="svc-hero__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="eager" />
            <p class="svc-hero__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
          <QuoteForm city="San Luis Obispo" title="Request a free estimate" variant="hero" />
        </aside>
      </div>
    </section>

    <section class="content-section" aria-labelledby="handle-title">
      <div class="container container--prose">
        <h2 id="handle-title" class="section-title">Electrical work I handle in San Luis Obispo</h2>
        <p class="lead-copy">I'm Adam Keif, a C-10 licensed residential electrician based in San Luis Obispo, and I run Keif Electric myself. The person who gives you the estimate is the same person who does the work. One estimate, one point of contact, from the first look to the final inspection.</p>
        <p>When a panel runs out of room or starts tripping, I handle <a href="/electrical-panel-upgrade-san-luis-obispo" class="inline-link">panel upgrades and service replacements</a>. I install <a href="/ev-charger-installation-san-luis-obispo" class="inline-link">Level 2 EV chargers</a> and confirm your panel can carry the load before I quote. I take care of <a href="/lighting-installation-san-luis-obispo" class="inline-link">recessed and custom lighting</a>, <a href="/electrical-repair-san-luis-obispo" class="inline-link">troubleshooting and repair</a> when something has quit or won't stay on, and full <a href="/new-construction-electrical-san-luis-obispo" class="inline-link">wiring for new construction and remodels</a>. If it's in a home in San Luis Obispo, it's what I do.</p>
      </div>
    </section>

    <section class="content-section content-section--alt" aria-labelledby="homes-title">
      <div class="container container--prose">
        <h2 id="homes-title" class="section-title">Older homes, newer loads</h2>
        <p>San Luis Obispo has a wide spread of housing, and the wiring usually matches the neighborhood. The older homes downtown and up around Foothill were built for a fraction of today's electrical load, and a lot of them are rentals. Laguna Lake and the mid-century tracts sit in between. Head out toward Edna Valley and you get larger lots and rural properties with their own needs. Newer construction toward the edges of town starts with more capacity.</p>
        <p>The electrical reality is that a lot of these homes were wired for a fraction of what a modern household draws. A 100-amp service was generous in its day. Add an EV charger, a heat pump, an induction range, and a home office, and it isn't. Some older panels are worth replacing on safety grounds alone, Federal Pacific and Zinsco in particular have known failure histories.</p>
        <p>I check what's actually there before quoting, so you find out what the job costs before it starts, not after.</p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="reasons-title">
      <div class="container container--prose">
        <h2 id="reasons-title" class="section-title">Common reasons homeowners call me</h2>
        <p>Most of my calls sound like one of these:</p>
        <ul class="feature-list">
          <li>The breakers keep tripping, or one won't reset.</li>
          <li>Lights flicker or dim when the AC or the microwave kicks on.</li>
          <li>The panel is full and there's no room to add a circuit.</li>
          <li>You need a dedicated circuit for a new appliance, a hot tub, or a workshop.</li>
          <li>You're putting in an EV charger and aren't sure the panel can handle it.</li>
          <li>You want outlets, a ceiling fan, or GFCI protection added in a kitchen, bath, or garage.</li>
          <li>You're remodeling and the wiring needs to come up to code.</li>
        </ul>
        <p>None of these are unusual. If one of them sounds like your house, that's a normal reason to call.</p>
      </div>
    </section>

    <section class="content-section content-section--alt" aria-labelledby="howiwork-title">
      <div class="container container--prose">
        <h2 id="howiwork-title" class="section-title">How I work</h2>
        <p>I come look at the job before quoting anything more than a simple service call. You get a written price before work begins, and that price is the price.</p>
        <p>Permits and inspections are part of the job, not an extra. Inside city limits that means the City of San Luis Obispo Building and Safety Division. I handle the filing and the scheduling.</p>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="container container--prose">
        <h2 id="why-title" class="section-title">Why San Luis Obispo homeowners hire Keif Electric</h2>
        <ul class="why-list">
          <li><strong>I'm actually here.</strong> Not a crew dispatched from another town. I live in San Luis Obispo, and the person who quotes your job is the person who does it.</li>
          <li><strong>Homes are my specialty.</strong> Residential wiring is what I do day in and day out, so your project gets my full attention.</li>
          <li><strong>One person, start to finish.</strong> No subcontractors, no handoffs, no explaining what you already explained to somebody else.</li>
        </ul>
      </div>
    </section>

    <section class="proof" aria-label="Recently completed work in San Luis Obispo">
      <div class="container">
        <span class="proof__eyebrow">Recently completed</span>
        <div class="proof__grid">
          <figure class="proof__figure">
            <img class="proof__img" src="/assets/200-amp-panel-upgrade-san-luis-obispo.jpg" alt="200-amp electrical panel upgrade with every circuit hand-labeled, installed by Keif Electric in San Luis Obispo, CA" width="900" height="1200" loading="lazy" decoding="async" />
            <figcaption class="proof__caption">200-amp panel upgrade. San Luis Obispo, CA.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="faq-section" id="faq" aria-labelledby="faq-title">
      <div class="container">
        <div class="faq-inner">
          <aside class="faq-sidebar">
            <span class="eyebrow">Questions</span>
            <h2 id="faq-title" class="faq-sidebar__title">San Luis Obispo FAQ</h2>
            <p>Have something else? Call and ask.</p>
            <a href="tel:+18052860477" class="btn-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z"/></svg>
              (805) 286-0477
            </a>
          </aside>
          <div class="faq-list">
            <details class="faq-item" open>
              <summary class="faq-item__btn"><span>Do I need a permit for electrical work in San Luis Obispo?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>For panel upgrades, new circuits, EV charger installs, and ADU wiring, yes. Inside city limits that goes through the City of San Luis Obispo Building and Safety Division at 919 Palm Street. If your address is in an unincorporated part of the county, it goes through SLO County instead, at 1585 Kansas Avenue. I figure out which one applies to your address and handle the filing and inspection scheduling.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Are there rebates for EV charger installation in San Luis Obispo?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Usually, yes. Most of San Luis Obispo is in 3CE territory, and their Electrify Your Ride program covers Level 2 chargers, installation, and the electrical work needed to get ready for one. PG&amp;E runs its own residential charging rebates on top of that. The federal tax credit for EV chargers ended on June 30, 2026, so that one is no longer available.</p><p>Amounts and eligibility windows change, sometimes more than once a year, so I'd rather tell you what's actually current when you call than post a number here that goes stale.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>My house is older. Can the panel handle an EV charger?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Depends what's in there. Plenty of older San Luis Obispo homes are still on 100-amp service, which may or may not have room depending on what else it's feeding. Some panels need replacing before anything else happens, especially older Federal Pacific and Zinsco equipment. I check the panel and do the load calculation before quoting, so the number you get includes whatever the job actually needs.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Do you work on rental properties?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>Yes. San Luis Obispo has a lot of rental housing and a lot of owners who don't live locally. I document the work so you have a record. Unpermitted electrical work is a real liability on a rental, so I permit what needs permitting.</p></div>
            </details>
            <details class="faq-item">
              <summary class="faq-item__btn"><span>Where are you based?</span><span class="faq-icon" aria-hidden="true"></span></summary>
              <div class="faq-item__body"><p>San Luis Obispo. That's my home and my service area, and I cover Paso Robles, Atascadero, Templeton, Santa Margarita, Morro Bay, Los Osos, and the surrounding county from here.</p></div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section class="page-cta" id="contact" aria-labelledby="cta-title">
      <div class="container">
        <div class="page-cta__inner">
          <div class="page-cta__copy">
            <span class="eyebrow eyebrow--amber">Need an electrician in San Luis Obispo?</span>
            <h2 id="cta-title" class="page-cta__title"><span class="page-cta__call">Call</span><a class="page-cta__num" href="tel:+18052860477">(805) 286-0477</a></h2>
            <p class="page-cta__lead">I quote the job myself, pull the permit, and do the work. San Luis Obispo is home, so scheduling is easy.</p>
            <a class="page-cta__alt" href="sms:+18052860477">Or text me at the same number.</a>
            <ul class="page-cta__facts">
              <li>California C-10 #1152084</li>
              <li>Liability insured</li>
              <li>Mon&ndash;Fri, 9am&ndash;5pm</li>
            </ul>
          </div>
          <div class="page-cta__card">
            <div class="page-cta__owner">
            <img class="page-cta__avatar" src="/assets/adam-keif.jpg" alt="" width="112" height="112" loading="lazy" />
            <p class="page-cta__owner-text"><strong>Adam Keif, owner.</strong> Reads every request and calls back the same business day.</p>
          </div>
            <QuoteForm city="San Luis Obispo" title="Or send it and I will call you" variant="hero" />
          </div>
        </div>
      </div>
    </section>

  </main>

  <noscript>
    <style>
      .content-section .container--prose,
      .why-section .container--prose,
      .proof-placeholder .container,
      .faq-inner,
    </style>
  </noscript>

  <Footer />
</BaseLayout>

<style>
  .container { max-width: var(--max); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .container--prose { max-width: 760px; }
  .breadcrumb { background: var(--ke-bone); border-bottom: 1px solid var(--border-1); padding: 12px 0; }
  .breadcrumb .container { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--fg-2); }
  .breadcrumb a { color: var(--ke-orange-text); font-weight: 500; }
  .breadcrumb a:hover { text-decoration: underline; }
  .svc-hero { position: relative; background: var(--ke-bone); overflow: hidden; padding: 72px 0 88px; }
  .svc-hero::before { content: ''; position: absolute; top: -25%; right: -12%; width: 62%; height: 130%; background: radial-gradient(closest-side, rgba(243, 152, 31, 0.12), transparent 72%); pointer-events: none; }
  .svc-hero__inner { position: relative; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; }
  .svc-hero__eyebrow { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ke-clay); margin-bottom: 18px; }
  .svc-hero__spark { width: 15px; height: 15px; color: var(--ke-orange); }
  .svc-hero__title { font-family: var(--font-sans); font-weight: 800; font-size: clamp(38px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.025em; color: var(--ke-ink); margin: 0; }
  .svc-hero__line { display: block; }
  .svc-hero__line--accent { color: var(--ke-orange); }
  .svc-hero__dot { display: inline-block; width: 0.16em; height: 0.16em; background: var(--ke-orange); border-radius: 2px; margin-left: 0.05em; vertical-align: baseline; }
  .svc-hero__place { display: block; font-family: var(--font-sans); font-weight: 600; font-size: clamp(15px, 1.6vw, 19px); letter-spacing: 0; color: var(--fg-2); margin-top: 16px; }
  .svc-hero__sub { font-size: 18px; line-height: 1.55; color: var(--ke-ink); max-width: 46ch; margin: 26px 0 26px; font-weight: 500; }
  .svc-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .svc-hero__trust { margin-top: 26px; font-size: 13px; font-weight: 600; color: var(--fg-2); letter-spacing: 0.01em; }
  .svc-hero__card { justify-self: end; width: 100%; max-width: 460px; background: #fff; border: 1px solid var(--border-1); border-radius: var(--radius-4); box-shadow: var(--shadow-3); padding: 24px 24px 22px; }
  .svc-hero__owner { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border-1); }
  .svc-hero__avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; object-position: 50% 12%; flex: none; border: 2px solid var(--ke-bone); box-shadow: 0 0 0 1px var(--border-1); }
  .svc-hero__owner-text { margin: 0; font-size: 14px; line-height: 1.45; color: var(--fg-2); }
  .svc-hero__owner-text strong { color: var(--ke-ink); }
  .svc-hero__fact { display: inline-flex; gap: 6px; align-items: baseline; margin: -4px 0 16px; padding: 7px 11px; background: var(--ke-bone); border-radius: var(--radius-2); font-size: 13px; color: var(--fg-2); }
  .svc-hero__fact strong { color: var(--ke-ink); font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .svc-hero__eyebrow, .svc-hero__line, .svc-hero__place, .svc-hero__sub, .svc-hero__ctas, .svc-hero__trust, .svc-hero__card { opacity: 0; animation: heroIn 0.8s var(--ease-emph) forwards; }
    .svc-hero__eyebrow { animation-delay: 0.05s; }
    .svc-hero__line:nth-child(1) { animation-delay: 0.13s; }
    .svc-hero__line:nth-child(2) { animation-delay: 0.21s; }
    .svc-hero__place { animation-delay: 0.29s; }
    .svc-hero__sub { animation-delay: 0.37s; }
    .svc-hero__ctas { animation-delay: 0.45s; }
    .svc-hero__trust { animation-delay: 0.53s; }
    .svc-hero__card { animation-delay: 0.22s; animation-duration: 1s; }
    .content-section .container--prose, .why-section .container--prose, .proof-placeholder .container, .faq-inner { opacity: 0; transform: translateY(22px); transition: opacity 0.7s var(--ease-emph), transform 0.7s var(--ease-emph); }
    .is-in { opacity: 1 !important; transform: none !important; }
  }
  @keyframes heroIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .btn { font-family: var(--font-sans); font-weight: 600; font-size: 15px; padding: 13px 18px; border-radius: var(--radius-2); border: 1px solid transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 9px; line-height: 1; min-height: 48px; transition: all var(--dur-1) var(--ease-out); text-decoration: none; white-space: nowrap; }
  .btn svg { width: 18px; height: 18px; flex: none; }
  .btn--primary { background: var(--ke-orange); color: #fff; }
  .btn--outline { background: transparent; color: var(--ke-ink); border: 1.5px solid var(--ke-ink); }
  .btn--outline:hover { background: var(--ke-ink); color: var(--ke-bone); }
  .btn--primary:hover { background: var(--ke-orange-dark); }
  .btn--primary:active { transform: translateY(1px); }
  .btn--outline-light { background: transparent; color: var(--ke-bone); border-color: rgba(246, 241, 232, 0.4); }
  .btn--outline-light:hover { background: rgba(246, 241, 232, 0.08); border-color: var(--ke-bone); }
  .btn--lg { padding: 16px 22px; font-size: 16px; border-radius: var(--radius-3); min-height: 54px; }
  .btn-link { display: inline-flex; align-items: center; gap: 8px; color: var(--ke-orange); font-weight: 600; font-size: 15px; text-decoration: none; }
  .btn-link svg { width: 16px; height: 16px; }
  .btn-link:hover { text-decoration: underline; }
  .content-section { padding: 80px 0; background: var(--ke-bone); }
  .content-section--alt { background: var(--ke-paper); }
  .section-title { font-family: var(--font-sans); font-weight: 800; font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.02em; line-height: 1.15; color: var(--ke-ink); margin-bottom: 20px; }
  .lead-copy { font-size: 17px; line-height: 1.6; color: var(--fg-1); margin-bottom: 20px; }
  .content-section p { font-size: 16px; line-height: 1.65; color: var(--fg-1); margin-bottom: 16px; max-width: 68ch; }
  .content-section p:last-child { margin-bottom: 0; }
  .inline-link { color: var(--ke-orange); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .why-section { background: var(--ke-ink); color: var(--ke-bone); padding: 80px 0; }
  .why-section .section-title { color: var(--ke-bone); }
  .why-list { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-direction: column; gap: 16px; }
