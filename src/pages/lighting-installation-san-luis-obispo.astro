---
import BaseLayout from '../components/layout/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ReviewBadges from '../components/ui/ReviewBadges.astro';
import QuoteForm from '../components/ui/QuoteForm.astro';

const title = 'Recessed Lighting Installation San Luis Obispo | Keif Electric';
const description = 'Recessed lighting, chandeliers, exterior and landscape lighting, dimmers and smart controls, installed to code and finished clean. Owner-operated by Adam Keif. Serving SLO County.';
const canonical = 'https://keifelectric.com/lighting-installation-san-luis-obispo';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Lighting Installation',
  description: 'Recessed lighting, chandeliers, exterior and landscape lighting, dimmers and smart controls. Code-compliant, finish-quality installation serving San Luis Obispo County.',
  url: canonical,
  image: 'https://keifelectric.com/assets/service-lighting.jpg',
  provider: { '@id': 'https://keifelectric.com/#business' },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'San Luis Obispo County, CA',
  },
  serviceType: 'Lighting Installation',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://keifelectric.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://keifelectric.com/#services' },
    { '@type': 'ListItem', position: 3, name: 'Lighting Installation', item: canonical },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can you convert my old ceiling fixtures to recessed lighting?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Retrofitting to recessed LED is one of the most common lighting jobs I do. I\'ll lay out spacing so the room lights evenly.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit for lighting work?',
      acceptedAnswer: { '@type': 'Answer', text: 'Simple fixture swaps usually don\'t. New circuits, exterior lighting, and larger projects often do. I\'ll tell you upfront and handle any permit needed.' },
    },
    {
      '@type': 'Question',
      name: 'Can you install a chandelier on a high ceiling?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes, with the correct fan/fixture-rated box and support. Heavy or high fixtures need the right mounting, which is exactly the part people shouldn\'t DIY.' },
    },
    {
      '@type': 'Question',
      name: 'Do you install smart or dimmable lighting?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes: dimmers, smart switches, and scene control, matched to fixtures that will actually dim without buzzing or flickering.' },
    },
    {
      '@type': 'Question',
      name: 'Why do my LED lights buzz or flicker when dimmed?',
      acceptedAnswer: { '@type': 'Answer', text: 'Usually a dimmer mismatch. Older dimmers were designed for incandescent loads and do not work correctly with the much smaller load an LED draws, which causes buzzing, flickering, or a narrow dimming range. The fix is pairing an LED-compatible dimmer with fixtures the manufacturer lists as compatible.' },
    },
    {
      '@type': 'Question',
      name: 'How many recessed lights does a room need?',
      acceptedAnswer: { '@type': 'Answer', text: 'A reasonable starting point is spacing cans about half the ceiling height apart, so roughly 4 feet on a standard 8-foot ceiling, then adjusting for the room shape and what the space is used for. Kitchens want light on the counters, living rooms usually want a softer general wash. I lay it out with you before cutting any holes.' },
    },
    {
      '@type': 'Question',
      name: 'What areas do you cover?',
      acceptedAnswer: { '@type': 'Answer', text: 'San Luis Obispo, Atascadero, Paso Robles, and surrounding SLO County.' },
    },
  ],
};
